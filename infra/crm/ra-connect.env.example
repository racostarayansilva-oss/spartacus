# Variáveis do RA Connect no servidor próprio. Copie para ra-connect.env (fica só na VPS, fora do Git).
# São as mesmas da Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). A anon key é pública; a service role NÃO vai aqui.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Monitor automático (DJEN + DataJud) — só no servidor próprio.
# Chave SECRETA do Supabase (Project Settings → API Keys → Secret keys, sb_secret_…).
# Fica só aqui: o servidor recusa publicá-la no navegador.
SUPABASE_SECRET_KEY=
# 0 desliga o monitor
MONITOR_ATIVO=1
# Para onde vai o resumo no WhatsApp: número com DDI+DDD (5591999999999) ou id do grupo (…@g.us). Vazio = só no sino.
MONITOR_WHATSAPP_DESTINO=
# Nome da instância na Evolution API (vazio = a que estiver conectada)
EVOLUTION_INSTANCIA=

# DataJud (CNJ) — opcional, há chave pública padrão
DATAJUD_API_KEY=

# IA (opcional)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMINI_MODELO=
IA_PADRAO=

# Consulta por CPF (paga, opcional)
CPF_CONSULTA_HABILITADA=0
CPF_PROVEDORES=judit,escavador,vigilant,jusneural
JUDIT_API_KEY=
ESCAVADOR_TOKEN=
VIGILANT_URL=
VIGILANT_TOKEN=
JUSNEURAL_TOKEN=
