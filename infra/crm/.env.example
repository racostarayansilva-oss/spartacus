# Copie para .env (o instalar.sh já faz isso e gera todos os segredos).

# Domínios (crie os dois registros DNS tipo A apontando para o IP da VPS)
# Domínio do RA Connect (ex.: racostaconnect.com; o www redireciona para ele)
DOMINIO_APP=
DOMINIO_CRM=crm.seudominio.com.br
DOMINIO_API=api-crm.seudominio.com.br
EMAIL_SSL=seu-email@gmail.com

# Endereço do RA Connect (o único site que pode abrir o CRM em iframe)
ORIGEM_RA_CONNECT=https://ra-connect-bt5d.vercel.app

# Versão das imagens do Evo CRM (fixa: só atualize depois de testar)
EVO_VERSION=1.1.0

# Segredos — gerados pelo instalar.sh
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
JWT_SECRET_KEY=
EVOAI_CRM_API_TOKEN=
DOORKEEPER_JWT_SECRET_KEY=
ENCRYPTION_KEY=
BOT_RUNTIME_SECRET=
AUTH_APIKEY_INTEGRATION_LOCAL=
CLICKHOUSE_PASSWORD=
RABBITMQ_PASSWORD=
# Mesmo valor vai na Vercel como CRM_SSO_TOKEN
RA_CONNECT_SSO_TOKEN=

# Evolution API (WhatsApp por QR Code) — gerada pelo instalar.sh
EVOLUTION_API_KEY=

# E-mail (opcional: recuperação de senha e MFA do CRM)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_SENDER_EMAIL=
