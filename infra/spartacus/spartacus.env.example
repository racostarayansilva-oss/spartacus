# Variáveis do app Spartacus no servidor próprio. Copie para spartacus.env (fica só na VPS, fora do Git).

# Supabase (Project Settings → API). A anon/publishable é pública; a secreta NÃO vai nesta linha.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave SECRETA do Supabase (sb_secret_…): monitor automático de todos os escritórios.
# Fica só aqui: o servidor recusa publicá-la no navegador.
SUPABASE_SECRET_KEY=
# 0 desliga o monitor (DJEN às 7h e 13h; DataJud às 6h, 12h e 18h, horário de Brasília)
MONITOR_ATIVO=1

# WhatsApp: a instância e o destino de cada escritório são cadastrados na Plataforma.
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=

# DataJud (CNJ) — opcional, há chave pública padrão
DATAJUD_API_KEY=

# IA (opcional, compartilhada pela plataforma)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMINI_MODELO=
IA_PADRAO=

# Consulta por CPF (paga, opcional)
CPF_CONSULTA_HABILITADA=0
CPF_PROVEDORES=judit,escavador,vigilant,jusneural
JUDIT_API_KEY=
ESCAVADOR_TOKEN=
VIGILANT_URL=
VIGILANT_TOKEN=
JUSNEURAL_TOKEN=
