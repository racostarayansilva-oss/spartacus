# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables.
# Nunca coloque chaves no código nem no Git.

# Supabase (banco + login). Sem estas duas, o app roda em "modo de testes" com dados no navegador.
# Supabase → Project Settings → API → Project URL e anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DataJud (CNJ). A chave pública é divulgada pelo CNJ e muda de tempos em tempos:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Consulta por CPF (pago). Preencha só o(s) contratado(s). Ordem de tentativa:
CPF_PROVEDORES=judit,escavador,vigilant,jusneural
JUDIT_API_KEY=
ESCAVADOR_TOKEN=
VIGILANT_URL=
VIGILANT_TOKEN=
JUSNEURAL_TOKEN=

# Precisa ser "1" para liberar a rota /api/cpf (custa dinheiro e envolve dados pessoais).
CPF_CONSULTA_HABILITADA=0

# Bases opcionais (só mude se o órgão trocar o endereço)
TCU_BASE=https://pesquisa.apps.tcu.gov.br/rest/publico/base
CARF_BASE=https://acordaos.economia.gov.br

# Resumo Inteligente do processo (Gemini, Google). Chave do Google AI Studio (AIza…) ou do Vertex AI express (AQ.…).
GEMINI_API_KEY=
# Opcional: modelo (padrão gemini-2.5-flash)
GEMINI_MODELO=
